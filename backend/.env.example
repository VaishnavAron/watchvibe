# ================================================================
# WatchVibe Enterprise Environment Configuration Template
# Duplicate this file as '.env' in backend directory and supply your keys.
# ================================================================

# ========== 1. Groq Cloud LLM (Phase 1 Intent & Phase 4 Explanation) ==========
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ========== 2. Neo4j Aura Graph Database (Phase 2 Knowledge Graph) ==========
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ========== 3. Pinecone Vector DB (Phase 2 ANN Vector Store) ==========
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_INDEX_NAME=movie-recommendation-embed

# ========== 4. Neural Embeddings: AWS EC2 Ollama (Qwen3 1024-dim) ==========
OLLAMA_HOST=http://your-ec2-ip:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# ========== 5. Fallback Embeddings: Voyage AI Cloud ==========
VOYAGE_API_KEY=pa-your_voyage_api_key_here
VOYAGE_EMBED_MODEL=voyage-4

# ========== 6. MongoDB Atlas (User Auth & Interaction Profiles) ==========
db_connection_string=mongodb+srv://<username>:<password>@cluster.mongodb.net/Movie_Recommendation

# ========== 7. Redis Cloud Cache (Session Blacklist & Query Caching) ==========
# Note: WatchVibe includes non-blocking resilience; if Redis is unreachable, system operates normally.
REDIS_HOST=your-redis-host.redislabs.com
REDIS_PORT=14989
REDIS_PASSWORD=your_redis_password_here
SKIP_REDIS_CACHE=false

# ========== 8. Authentication & Server Settings ==========
JWT_SECRET=your_secure_jwt_secret_phrase
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500
BYPASS_AUTH=false
